# Neon PostgreSQL connection string (pooled URL recommended on Vercel)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Long random secret shared only with the ESP-01; never use NEXT_PUBLIC_ here.
DEVICE_API_KEY=replace-with-a-long-random-secret

# Optional: device identifier accepted by ingestion (default: nursery-01)
DEVICE_ID=nursery-01

# Device considered offline after this many seconds (default: 30)
DEVICE_OFFLINE_SECONDS=30

# Optional: API request origin restriction for browser mutations (comma-separated)
ALLOWED_ORIGINS=
